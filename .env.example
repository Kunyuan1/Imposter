# Copy this file to .env and fill in your own values.
#
# NOTE: anything prefixed VITE_ is inlined into the client bundle by Vite and
# is therefore public. Never put a real secret behind a VITE_ prefix — if this
# app ever needs to call an API with a private key, that call belongs in
# server.js, reading a non-VITE_ variable.
VITE_ANTHROPIC_API_KEY=your_actual_api_key_here

# WebSocket server the client connects to.
VITE_WS_URL=wss://imposter-production-ee88.up.railway.app
